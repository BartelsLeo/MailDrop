    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.23.0",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/office-js": "^1.0.610",
    "office-addin-dev-certs": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
