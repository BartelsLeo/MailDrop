{
  "name": "maildrop-web",
  "version": "0.1.0",
  "private": true,
  "description": "MailDrop als Outlook-Web-Add-in - technischer Prototyp (Machbarkeitsprüfungen)",
  "type": "module",
  "scripts": {
    "models": "node scripts/copy-models.mjs",
    "dev": "npm run models && vite",
