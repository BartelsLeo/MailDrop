<UserControl x:Class="MailDropWpfTaskPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MailDrop"
             Height="400" Width="250">
    <UserControl.Resources>
        <local:PathShortenerConverter x:Key="PathShortenerConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label x:Name="LabelProjektordner" Content="Basisverzeichnis / Projektverzeichnis" Grid.Row="0"/>
            <ListBox x:Name="ListBox1" Height="69" ItemsSource="{Binding ProjektVerzeichnisse}" SelectedItem="{Binding SelectedProjekt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource PathShortenerConverter}}" ToolTipService.ShowDuration="60000">
                            <TextBlock.ToolTip>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Width="350"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Label x:Name="LabelAblageordner" Content="Projektstruktur" Grid.Row="2"/>
            <TreeView x:Name="TreeView1" ItemsSource="{Binding TreeViewData}" Height="300" Grid.Row="3">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="TreeViewItem.IsExpanded" Value="True"/>
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <Grid Margin="0,5,0,0" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelTitel" Content="Titel" Grid.Column="0"/>
                <TextBox x:Name="TextBoxTitel"
                         Text="{Binding Titel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelAblageordnerField" Content="Ablageordner" Grid.Column="0"/>
                <TextBox x:Name="TextBoxAblageordner"
                         Text="{Binding AblageordnerFeld, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxAblageordner_GotFocus"
                         LostFocus="TextBoxAblageordner_LostFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         Grid.Column="1"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelMsgDateiname" Content="msg Dateiname" Grid.Column="0"/>
                <TextBox x:Name="TextBoxMsgDateiname"
                         Text="{Binding MsgDateinameFeld, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxMsgDateiname_GotFocus"
                         LostFocus="TextBoxMsgDateiname_LostFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         Grid.Column="1"/>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0" Grid.Row="7">
                <Label x:Name="LabelAnhaenge" Content="Anh&#228;nge ablegen" Width="110"/>
                <CheckBox x:Name="CheckBoxAnhaenge" VerticalAlignment="Center" IsChecked="{Binding AnhaengeAblegen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <!-- Platzhalter  bersicht als Expander, ersetzt LabelMetadaten und DataGridMetadaten -->
            <Expander Header="Platzhalter Übersicht" IsExpanded="False" Margin="0,5,0,0" Grid.Row="8" Grid.RowSpan="2">
                <ItemsControl>
                    <TextBlock Text="[Titel]" />
                    <TextBlock Text="[Absender]" />
                    <TextBlock Text="[Absender-Domain]" />
                    <TextBlock Text="[Empfänger]" />
                    <TextBlock Text="[Empfänger (kurz)]" />
                    <TextBlock Text="[Betreff]" />
                    <TextBlock Text="[Datum]" />
                    <TextBlock Text="[Datum (formatiert)]" />
                </ItemsControl>
            </Expander>
        </Grid>
    </ScrollViewer>
</UserControl>
