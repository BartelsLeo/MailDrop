<UserControl x:Class="MailDropWpfTaskPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MailDrop">
    <UserControl.Resources>
        <local:PathShortenerConverter x:Key="PathShortenerConverter"/>
    </UserControl.Resources>
    <Border Padding="0,0,20,0">
           <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                    Padding="6,6,6,6" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="(keine Mail ausgew&#228;hlt)" FontStyle="Italic" Foreground="#999999" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Betreff}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Betreff}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Betreff}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Betreff}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Betreff}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/>
                        <TextBlock Text="{Binding Datum, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                   Foreground="#666666" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Label x:Name="LabelProjektordner" Grid.Row="1" HorizontalAlignment="Stretch"><TextBlock Text="Basisverzeichnis / Projektverzeichnis" TextWrapping="Wrap"/></Label>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="ListBox1"
                         ItemsSource="{Binding ProjektVerzeichnisse}"
                         SelectedItem="{Binding ProjektPfad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Column="0" HorizontalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PathShortenerConverter}}" ToolTipService.ShowDuration="60000">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SparkleProjektPfad" Text="&#x2726;" Grid.Column="1"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </Grid>
            <Label x:Name="LabelAblageordner" Grid.Row="3"><TextBlock Text="Projektstruktur" TextWrapping="Wrap"/></Label>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TreeView x:Name="TreeView1" ItemsSource="{Binding TreeViewData}" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreviewMouseRightButtonDown="TreeView1_PreviewMouseRightButtonDown">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Neuer Ordner" Click="MenuItemNeuerOrdner_Click"/>
                            <MenuItem Header="L&#246;schen" Click="MenuItemLoeschen_Click"/>
                            <MenuItem Header="Umbenennen" Click="MenuItemUmbenennen_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="TreeViewItem.IsExpanded" Value="True"/>
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                    <Button x:Name="ButtonNeuenOrdner" Content="Neuen Ordner" Grid.Row="1" Grid.Column="0"
                        Width="110" Height="24" HorizontalAlignment="Left" Margin="0,6,0,0"
                        Click="ButtonNeuenOrdner_Click"/>
                    <TextBlock x:Name="SparkleProjektstrukturPfad" Text="&#x2726;" Grid.RowSpan="2" Grid.Column="1"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="5" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelTitel" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="Titel" TextWrapping="Wrap"/></Label>
                <TextBox x:Name="TextBoxTitel"
                         Text="{Binding Titel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxTitel_GotFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleTitel" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="6" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelAbsenderKurz" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="Absender (kurz)" TextWrapping="Wrap"/></Label>
                <TextBox x:Name="TextBoxAbsenderKurz"
                         Text="{Binding AbsenderKurz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxAbsenderKurz_GotFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleAbsenderKurz" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="7" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelAblageordnerField" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="Ablageordner" TextWrapping="Wrap"/></Label>
                <TextBox x:Name="TextBoxAblageordner"
                         Text="{Binding AblageordnerFeld, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxAblageordner_GotFocus"
                         LostFocus="TextBoxAblageordner_LostFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleAblageordner" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="8" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelMsgDateiname" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="msg Dateiname" TextWrapping="Wrap"/></Label>
                <TextBox x:Name="TextBoxMsgDateiname"
                         Text="{Binding MsgDateinameFeld, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxMsgDateiname_GotFocus"
                         LostFocus="TextBoxMsgDateiname_LostFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleMsgDateiname" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="9" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelAnhaenge" Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="Anh&#228;nge ablegen" TextWrapping="Wrap"/></Label>
                <CheckBox x:Name="CheckBoxAnhaenge" VerticalAlignment="Center" IsChecked="{Binding AnhaengeAblegen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="CheckBoxAnhaenge_Click" Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleAnhaengeAblegen" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0" Grid.Row="10">
                    <Button x:Name="ButtonInfo" Content="i" Width="24" Height="24" Margin="2,0,2,0" ToolTip="Hinweise zu Platzhaltern sowie Export/Import der SuggestionRecords" Click="ButtonInfo_Click"/>
                <Button x:Name="ButtonOk" Content="OK" Width="50" Height="24" Margin="2,0,2,0" Click="ButtonOk_Click"/>
                <Button x:Name="ButtonAbbrechen" Content="Abbrechen" Width="80" Height="24" Margin="2,0,2,0" Click="ButtonAbbrechen_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
