<UserControl x:Class="MailDropWpfTaskPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MailDrop"
             Height="400" MinWidth="700">
    <UserControl.Resources>
        <local:PathShortenerConverter x:Key="PathShortenerConverter"/>
    </UserControl.Resources>
    <Border Padding="0,0,20,0">
        <Grid Margin="0" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1"
                    Padding="6,6,6,6" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Betreff}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock Text="{Binding Datum, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                               Foreground="#666666" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Label x:Name="LabelProjektordner" Content="Basisverzeichnis / Projektverzeichnis" Grid.Row="1" HorizontalAlignment="Stretch"/>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="ListBox1"
                         ItemsSource="{Binding ProjektVerzeichnisse}"
                         SelectedItem="{Binding ProjektstrukturPfad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Grid.Column="0" HorizontalAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PathShortenerConverter}}" ToolTipService.ShowDuration="60000">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SparkleProjektPfad" Text="&#x2726;" Grid.Column="1"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </Grid>
            <Label x:Name="LabelAblageordner" Content="Projektstruktur" Grid.Row="3"/>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <TreeView x:Name="TreeView1" ItemsSource="{Binding TreeViewData}" Height="300" Grid.Column="0" HorizontalAlignment="Stretch">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="TreeViewItem.IsExpanded" Value="True"/>
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock x:Name="SparkleProjektstrukturPfad" Text="&#x2726;" Grid.Column="1"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="5" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelTitel" Content="Titel" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBoxTitel"
                         Text="{Binding Titel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxTitel_GotFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleTitel" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="6" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelAbsenderKurz" Content="Absender (kurz)" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBoxAbsenderKurz"
                         Text="{Binding AbsenderKurz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxAbsenderKurz_GotFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleAbsenderKurz" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="7" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelAblageordnerField" Content="Ablageordner" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBoxAblageordner"
                         Text="{Binding AblageordnerFeld, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxAblageordner_GotFocus"
                         LostFocus="TextBoxAblageordner_LostFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleAblageordner" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="8" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelMsgDateiname" Content="msg Dateiname" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBoxMsgDateiname"
                         Text="{Binding MsgDateinameFeld, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         GotFocus="TextBoxMsgDateiname_GotFocus"
                         LostFocus="TextBoxMsgDateiname_LostFocus"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         Grid.Column="1" Margin="0"/>
                <TextBlock x:Name="SparkleMsgDateiname" Text="&#x2726;" Grid.Column="2"
                           Opacity="0" Foreground="#FFB300" FontSize="14"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,5,0,0" Grid.Row="9" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="LabelAnhaenge" Content="Anh&#228;nge ablegen" Grid.Column="0" VerticalAlignment="Center"/>
                <CheckBox x:Name="CheckBoxAnhaenge" VerticalAlignment="Center" IsChecked="{Binding AnhaengeAblegen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,0" Grid.Row="10">
                <Button x:Name="ButtonInfo" Content="i" Width="24" Height="24" Margin="2,0,2,0" ToolTip="Hinweise zu Platzhaltern" Click="ButtonInfo_Click"/>
                <Button x:Name="ButtonOk" Content="OK" Width="50" Height="24" Margin="2,0,2,0" Click="ButtonOk_Click"/>
                <Button x:Name="ButtonAbbrechen" Content="Abbrechen" Width="80" Height="24" Margin="2,0,2,0" Click="ButtonAbbrechen_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
