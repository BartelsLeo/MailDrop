<Window x:Class="AttachmentRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dateiname zu lang" Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Hinweistext -->
            <RowDefinition Height="Auto"/> <!-- Eingabefeld -->
            <RowDefinition Height="Auto"/> <!-- Überlänge-Zähler -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>
        <TextBlock x:Name="TextBlockHint" Grid.Row="0"
                   Text="Der Dateiname ist zu lang. Bitte geben Sie einen neuen Namen ein:"
                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Width="380" Margin="0,0,0,8"/>
        <TextBox x:Name="TextBoxFileName" Grid.Row="1" Height="28" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock x:Name="TextBlockOverlength" Grid.Row="2" Foreground="Red" FontSize="12" Margin="0,0,0,8" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="ButtonOk_Click"/>
            <Button Content="Abbrechen" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
