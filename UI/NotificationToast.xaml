<Window x:Class="NotificationToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Opacity="0">
    <!-- Aussenrand als Platz fuer den Schlagschatten: ohne Margin wuerde der Effekt am
         Fensterrand abgeschnitten, da das Fenster per SizeToContent exakt um den Border passt. -->
    <Grid Margin="14">
        <Border x:Name="ToastBorder"
                BorderThickness="1" CornerRadius="4" Padding="12,8"
                MaxWidth="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                  Opacity="0.28" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" FontWeight="Bold" FontSize="14"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="300"/>
                <Button x:Name="ButtonOpenAblageordner" Content="Öffnen"
                        Margin="10,0,0,0" Padding="0" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="ButtonOpenAblageordner_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- Foreground wird pro Toast-Art im Code-Behind gesetzt und hier
                                 uebernommen, statt wie bei den fruheren Inline-Notifications
                                 je Variante fest im Template zu stehen. -->
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="12" FontWeight="Bold" TextDecorations="Underline"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
