<Window x:Class="InfoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailDrop - Hinweis" Height="520" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,10">Hinweise</TextBlock>

                <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">Ablageordner und msg Dateiname</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Die Felder 'Ablageordner' und 'msg Dateiname' werden dynamisch aus einem Schema zusammengesetzt. Das erlaubt eine Vereinheitlichung der Ordner- und Dateinamen. Es ist daher ratsam, ein Schema festzulegen und nicht mehr zu ändern. Im Schema können folgende Variablen verwendet werden:"/>
                <ItemsControl Margin="0,0,0,10">
                    <TextBlock Text="[Titel]" />
                    <TextBlock Text="[Absender]" />
                    <TextBlock Text="[Absender-Domain]" />
                    <TextBlock Text="[Empfänger]" />
                    <TextBlock Text="[Empfänger (kurz)]" />
                    <TextBlock Text="[Betreff]" />
                    <TextBlock Text="[Datum]" />
                    <TextBlock Text="[Datum (formatiert)]" />
                    <TextBlock Text="[Absender (kurz)]" />
                </ItemsControl>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Feste, undynamische Textteile im Schema erfordern Anführungszeichen, z. B. &quot;gelesen&quot;."/>
                <TextBlock TextWrapping="Wrap"
                           Text="Trennzeichen zwischen Variablen erfordern keine Einfassung, z. B. [Datum]_[Titel]. Ist eine Variable leer, wird das Trennzeichen _ nicht eingefügt."/>

                <Separator Margin="0,10,0,10"/>
                <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">Vorschläge</TextBlock>
                <TextBlock TextWrapping="Wrap"
                           Text="Für die ausgewählte E-Mail werden für alle Felder Vorschläge erzeugt und mit ✦ markiert. Die Vorschläge basieren auf den bisherigen Mail-Ablagen."/>

                <Separator Margin="0,10,0,10"/>
                <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">Vorschlagsdaten exportieren</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Die Vorschlagsdaten des Benutzers werden in folgender Datei gespeichert:"/>
                <TextBox x:Name="TxtDbPath" IsReadOnly="True" TextWrapping="Wrap"
                         Margin="0,0,0,8" Padding="4"
                         Background="#F5F5F5" BorderBrush="#CCCCCC"
                         FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Disabled"/>
                <TextBlock TextWrapping="Wrap"
                           Text="Diese Datei kann kopiert und auf einem anderen Computer oder für einen anderen Nutzer an gleicher Stelle eingefügt werden."/>

                <Separator Margin="0,10,0,10"/>
                <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">Vorschläge verbessern</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Alle 50 Ablagen wird die Gewichtung des Vorschlagsalgorithmus automatisch aktualisiert. Erscheinen die Vorschläge unpassend oder wurden Vorschlagsdaten importiert, kann die Gewichtung auch manuell aktualisiert werden."/>
                <Button x:Name="ButtonGewichteNeuBerechnen" Content="Gewichte neu berechnen"
                        HorizontalAlignment="Left" Padding="12,6" FontSize="12"
                        Click="ButtonGewichteNeuBerechnen_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
