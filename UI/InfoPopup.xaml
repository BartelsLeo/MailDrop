<Window x:Class="InfoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailDrop - Hinweis" Height="580" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="White"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Section header: small, uppercase, indigo accent -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Body text -->
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <!-- Flat divider between sections -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Margin" Value="0,16,0,16"/>
        </Style>

        <!-- Placeholder chip -->
        <Style x:Key="PlaceholderChip" TargetType="Border">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style x:Key="PlaceholderChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#4338CA"/>
        </Style>

        <!-- Secondary button (matches task pane) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F9FAFB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
        <StackPanel Margin="18,16,14,16">
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="4" Padding="12,10" Margin="0,0,0,16">
                <TextBlock FontWeight="Bold" FontSize="14" Foreground="#111827" Text="Hinweise"/>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="ABLAGEORDNER UND MSG DATEINAME"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,10"
                       Text="Die Felder 'Ablageordner' und 'msg Dateiname' werden dynamisch aus einem Schema zusammengesetzt. Das erlaubt eine Vereinheitlichung der Ordner- und Dateinamen. Es ist daher ratsam, ein Schema festzulegen und nicht mehr zu ändern. Im Schema können folgende Variablen verwendet werden:"/>
            <WrapPanel Margin="0,0,0,10">
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Titel]"/></Border>
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Absender]"/></Border>
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Absender-Domain]"/></Border>
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Empfänger]"/></Border>
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Empfänger (kurz)]"/></Border>
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Betreff]"/></Border>
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Datum]"/></Border>
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Datum (formatiert)]"/></Border>
                <Border Style="{StaticResource PlaceholderChip}"><TextBlock Style="{StaticResource PlaceholderChipText}" Text="[Absender (kurz)]"/></Border>
            </WrapPanel>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6"
                       Text="Feste, undynamische Textteile im Schema erfordern Anführungszeichen, z. B. &quot;gelesen&quot;."/>
            <TextBlock Style="{StaticResource BodyText}"
                       Text="Trennzeichen zwischen Variablen erfordern keine Einfassung, z. B. [Datum]_[Titel]. Ist eine Variable leer, wird das Trennzeichen _ nicht eingefügt."/>

            <Border Style="{StaticResource Divider}"/>
            <TextBlock Style="{StaticResource SectionHeader}" Text="VORSCHLÄGE"/>
            <TextBlock Style="{StaticResource BodyText}"
                       Text="Für die ausgewählte E-Mail werden für alle Felder Vorschläge erzeugt und mit ✦ markiert. Die Vorschläge basieren auf den bisherigen Mail-Ablagen."/>

            <Border Style="{StaticResource Divider}"/>
            <TextBlock Style="{StaticResource SectionHeader}" Text="VORSCHLAGSDATEN EXPORTIEREN"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6"
                       Text="Die Vorschlagsdaten des Benutzers werden in folgender Datei gespeichert:"/>
            <TextBox x:Name="TxtDbPath" IsReadOnly="True" TextWrapping="Wrap"
                     Margin="0,0,0,8" Padding="6"
                     Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1"
                     FontFamily="Consolas" FontSize="11" Foreground="#374151"
                     VerticalScrollBarVisibility="Disabled"/>
            <TextBlock Style="{StaticResource BodyText}"
                       Text="Diese Datei kann kopiert und auf einem anderen Computer oder für einen anderen Nutzer an gleicher Stelle eingefügt werden."/>

            <Border Style="{StaticResource Divider}"/>
            <TextBlock Style="{StaticResource SectionHeader}" Text="VORSCHLÄGE VERBESSERN"/>
            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,12"
                       Text="Alle 50 Ablagen wird die Gewichtung des Vorschlagsalgorithmus automatisch aktualisiert. Erscheinen die Vorschläge unpassend oder wurden Vorschlagsdaten importiert, kann die Gewichtung auch manuell aktualisiert werden."/>
            <Button x:Name="ButtonGewichteNeuBerechnen" Content="Gewichte neu berechnen"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left"
                    Click="ButtonGewichteNeuBerechnen_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
