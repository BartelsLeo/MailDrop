<Window x:Class="InfoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MailDrop - Hinweis" Height="520" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,10">Hinweise</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="In den Feldern 'Ablageordner' und 'msg Dateiname' können folgende Platzhalter verwendet werden."/>
                <ItemsControl>
                    <TextBlock Text="[Titel]" />
                    <TextBlock Text="[Absender]" />
                    <TextBlock Text="[Absender-Domain]" />
                    <TextBlock Text="[Empfänger]" />
                    <TextBlock Text="[Empfänger (kurz)]" />
                    <TextBlock Text="[Betreff]" />
                    <TextBlock Text="[Datum]" />
                    <TextBlock Text="[Datum (formatiert)]" />
                    <TextBlock Text="[Absender (kurz)]" />
                </ItemsControl>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Somit werden die Felder dynamisch ausgefüllt."/>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Fest stehender Text muss in doppelte Anführungszeichen gesetzt werden, z. B. [Titel]&quot; (Entwurf)&quot;. Dieser Text bleibt immer erhalten, auch wenn ein benachbarter Platzhalter leer ist."/>
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Text ohne Anführungszeichen zwischen zwei Platzhaltern (z. B. das &quot;_&quot; im Standardschema) gilt als Trennzeichen: Ist einer der beiden Platzhalter leer, wird dieses Trennzeichen automatisch weggelassen - so entstehen keine überflüssigen Trenner am Anfang, Ende oder in der Mitte des Ergebnisses."/>
                <Separator Margin="0,10,0,10"/>
                <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">SuggestionRecords übertragen</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Die Vorschlagsdaten (SuggestionRecords) liegen in der SQLite-Datei:"/>
                <TextBox x:Name="TxtDbPath" IsReadOnly="True" TextWrapping="Wrap"
                         Margin="0,0,0,8" Padding="4"
                         Background="#F5F5F5" BorderBrush="#CCCCCC"
                         FontFamily="Consolas" FontSize="11"
                         VerticalScrollBarVisibility="Disabled"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Export: Diese Datei an einen sicheren Ort kopieren (z. B. Netzlaufwerk oder USB-Stick)."/>
                <TextBlock TextWrapping="Wrap"
                           Text="Import: Auf dem anderen PC die Datei wieder unter exakt demselben Pfad ablegen und vorhandene Datei ersetzen."/>
                <Separator Margin="0,10,0,10"/>
                <TextBlock FontWeight="Bold" FontSize="13" Margin="0,0,0,6">Vorschlagsgewichte</TextBlock>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Die Gewichte für die Vorschlagsberechnung werden alle 50 Ablagen automatisch neu berechnet. Hier können sie manuell aktualisiert werden – sinnvoll nach dem Import von SuggestionRecords oder wenn Vorschläge unpassend wirken."/>
                <Button x:Name="ButtonGewichteNeuBerechnen" Content="Gewichte neu berechnen"
                        HorizontalAlignment="Left" Padding="12,6" FontSize="12"
                        Click="ButtonGewichteNeuBerechnen_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
